#!/usr/bin/make -f
# -*- makefile -*-

export DH_VERBOSE=1

configure: configure-stamp
configure-stamp:
	dh_testdir

	touch $@

build: build-stamp
build-stamp: configure-stamp
	dh_testdir

	$(MAKE) CFLAGS="-I/usr/include/ffmpeg-ma" FFMPEG_SUFFIX=-ma

	touch $@

clean:
	dh_testdir
	dh_testroot
	dh_clean
	rm -f build-stamp configure-stamp dec_tx_test

install: build
	dh_testdir
	dh_testroot
	dh_prep
	dh_installdirs

	install -Dm 755 dec_tx_test $(CURDIR)/debian/tmp/usr/bin/dec_tx_test

# Build architecture-independent files here.
binary-indep: build install
# We have nothing to do by default.

# Build architecture-dependent files here.
binary-arch: build install
	dh_testdir
	dh_testroot
	dh_install --sourcedir=debian/tmp
	dh_installman
	dh_link
	dh_strip
	dh_compress
	dh_fixperms
	dh_makeshlibs
	dh_installdeb
	dh_shlibdeps
	dh_gencontrol
	dh_md5sums
	dh_builddeb

binary: binary-indep binary-arch
.PHONY: build clean binary-indep binary-arch binary install configure
